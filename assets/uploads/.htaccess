# Disable script execution inside uploads folder (Defense in Depth)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Prevent script handlers
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .pht .phar .inc .cgi .pl .py .sh
SetHandler default-handler

# Disable directory browsing & execution
Options -ExecCGI -Indexes
