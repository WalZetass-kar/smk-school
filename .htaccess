RewriteEngine On

# Deny direct access to internal directories (config, includes, database, pages)
RewriteRule ^(config|includes|database|pages)/ - [F,L]

# Deny access to sensitive files and extensions
RewriteRule \.(sql|env|md|log|git|gitignore|lock|json)$ - [F,L]

# Dynamic sitemap: /sitemap.xml -> sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# Let real files/folders (assets, admin/*.php, etc.) pass through untouched.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes through the front controller.
RewriteRule ^ index.php [L]
